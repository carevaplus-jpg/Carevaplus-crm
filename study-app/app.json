{
  "expo": {
    "name": "Vidya",
    "slug": "vidya",
    "version": "1.0.0",
    "description": "Vidya: an immersive CBSE / NCERT study companion for Classes 8–12.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vidya",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06060C",
    "primaryColor": "#8B6CFF",
    "ios": {
      "bundleIdentifier": "app.vidya.study",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "app.vidya.study",
      "adaptiveIcon": {
        "backgroundColor": "#06060C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Vidya",
      "themeColor": "#06060C",
      "backgroundColor": "#06060C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06060C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
